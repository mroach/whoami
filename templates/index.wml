<!DOCTYPE wml PUBLIC "-//WAPFORUM//DTD WML 1.1//EN" "http://www.wapforum.org/DTD/wml_1.1.xml">
<wml>
  <head>
    <meta name="author" content="mroach"/>
  </head>

  <card id="main" title="{{.Title}}">
    <p align="center">{{.Request.IP.Address}}</p>

    {{ if .Request.Location }}
    <p>
      {{if .Request.Location.City}}{{.Request.Location.City}}, {{end}}{{.Request.Location.Country.Name}}
      <img src="images/flags/{{.Request.Location.Country.ISOCode | ToLower}}.gif" alt="{{.Request.Location.Country.Name}}"/>
    </p>
    {{  end  }}

    {{- if .Request.ASN -}}
    <p>
      {{.Request.ASN.Name}} (AS{{.Request.ASN.Number}})
      <img src="images/asn/{{.Request.ASN.Number}}.png" height="16" width="16" alt=""/>
    </p>
    {{- end -}}

    <p>{{.Request.HTTP.Protocol}}</p>

    <p><b>Server time:</b> {{.Request.Server.Time}}</p>

    <p>
      <anchor>
        <go href="#headers"/>
        HTTP Headers
      </anchor>
    </p>

    <p>
      <img src="images/visitor/{{.CacheBust}}.gif" alt=""/>
    </p>
  </card>

  <card id="headers" title="HTTP Headers">
    {{- range $ix, $header := .Request.HTTP.Headers }}
    <p><b>{{$header.Name}}:</b> {{$header.Value}}</p>
    {{- end }}
    <p>
      <anchor>
        <go href="#main"/>
        Home
      </anchor>
    </p>
  </card>
</wml>
